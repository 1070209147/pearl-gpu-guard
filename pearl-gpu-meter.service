[Unit]
Description=Read whole-chassis power through local IPMI DCMI
After=systemd-tmpfiles-setup.service

[Service]
Type=simple
User=root
Group=pearl-gpu
ExecStart=/usr/bin/python3 -I /opt/pearl-gpu-guard/guard.py ipmi-meter
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/pearl-gpu-guard

[Install]
WantedBy=multi-user.target
